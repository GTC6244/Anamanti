{
  // Cloudflare Workers config for the Anamanti website.
  //
  // The only Cloudflare-deployed content in this repo is the static website in
  // `website/` (index.html plus one page per section, shared assets/). This is an
  // "assets-only" Worker: it has no server code, it just serves that directory as
  // static files. Clean URLs (/core -> core.html) come from Workers' default
  // html_handling ("auto-trailing-slash").
  //
  // Deployment is driven by GitHub Actions, not Cloudflare's Git integration:
  // see .github/workflows/deploy-website.yml, which runs `wrangler deploy`
  // only when the website changes land on `main`. The old Cloudflare
  // "Workers Builds" Git integration (which ran on every push and failed on
  // PRs that never touched website/) should be disabled in the dashboard.
  "name": "anamanti",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./website"
  }
}
