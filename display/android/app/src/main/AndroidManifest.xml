<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phase 2: the Rust engine captures mic audio for on-device wake-word
         detection (Plan.MD §3). AAudio input requires the RECORD_AUDIO runtime
         permission; without it `cpal` cannot open the input device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Kotlin AudioRecord capture shim: attaching the platform AcousticEchoCanceler
         / AutomaticGainControl / NoiseSuppressor audio effects requires this. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-feature android:name="android.hardware.microphone" android:required="true"/>
    <!-- Phase 5: the front camera is used as a proximity sensor — a cheap Rust
         frame-motion detector brightens the idle screen when someone approaches
         (Plan.MD §5). CAMERA is a runtime-dangerous permission; like RECORD_AUDIO it
         is granted out-of-band on the kiosk device (adb `pm grant`). Marked
         required=false so the app still installs on hardware without a camera —
         proximity just stays disabled. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <!-- Phase 3: the Rust engine opens a TCP (Wyoming) connection to the Mac Mini
         orchestrator. A release build needs INTERNET explicitly — Flutter only
         adds it to the debug/profile manifests by default. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Phase 3: the orchestrator is discovered via multicast mDNS (_wyoming._tcp).
         Android drops inbound multicast unless the app holds a WifiManager
         MulticastLock, which requires these permissions. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <application
        android:label="ambient_display"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
