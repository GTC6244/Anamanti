<?xml version="1.0" encoding="UTF-8"?>
<!-- Ambient snapserver (Mac hub). Install:
       cp com.ambient.snapserver.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.ambient.snapserver.plist
     Snapfifos must exist first (run setup-mac.sh). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ambient.snapserver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/snapserver</string>
    <string>-c</string>
    <string>/opt/homebrew/etc/snapserver.conf</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/opt/homebrew/var/log/ambient-snapserver.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/homebrew/var/log/ambient-snapserver.log</string>
</dict>
</plist>
