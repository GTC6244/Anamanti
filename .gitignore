# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/display/build/
/display/build
/display/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/display/android/app/debug
/display/android/app/profile
/display/android/app/release

# Orchestrator runtime memory DB (created at run time)
ambient_memory.sqlite
ambient_memory.sqlite-*

# Orchestrator per-instance boot config (may contain OAuth client secrets / refresh
# tokens in plaintext — keep 0600, never commit). See orchestrator/ambient.example.json.
ambient.json

# Orchestrator persisted runtime settings (contains the search API key in plaintext)
ambient_settings.json

# Orchestrator runtime chat log (append-only turn record; GraphRAG ingest queue)
ambient_chatlog.jsonl
ambient_chatlog.jsonl-*
ambient_chatlog.jsonl.offset
ambient_helix/

# Orchestrator runtime prompt log (per-turn assembled LLM prompt; debug GUI)
ambient_promptlog.jsonl
ambient_promptlog.jsonl-*

# On-device Google OAuth client credentials (client id + secret) for the photo
# slideshow. Injected at build with --dart-define-from-file=google_oauth.json.
# Never commit the real file; the committed google_oauth.example.json is the template.
/display/google_oauth.json

# Google Drive refresh token synced from the Mac consent helper. Live token — never commit.
/display/google_drive_token.json

# Local test-orchestrator run dir (worktree-local; never commit)
.ambient-test-run/
